# ---- mode ----------------------------------------------------------------
DRY_RUN=true                  # paper trading. Set false ONLY after testing.
PAPER_BALANCE_SOL=5

# ---- PumpPortal ---------------------------------------------------------
# Required: trade/account streams need an API key funded with >= 0.02 SOL.
# Create one at https://pumpportal.fun (it creates a linked wallet; fund it).
PUMPPORTAL_API_KEY=

# ---- live trading (only when DRY_RUN=false) -----------------------------
PRIVATE_KEY=                  # base58 secret key of a DEDICATED hot wallet
RPC_URL=https://api.mainnet-beta.solana.com   # use a paid RPC (Helius, Triton...) for speed

# ---- trader discovery ---------------------------------------------------
TOP_N_TRADERS=25
LEADERBOARD_WINDOW_HOURS=24
MIN_ROUND_TRIPS=3
MIN_MEDIAN_HOLD_SEC=120         # skip scalpers who usually flip faster than this
LEADERBOARD_REFRESH_SEC=300
MAX_TRACKED_TOKENS=400
SEED_TRADERS_FILE=traders.txt
EXCLUDE_WALLETS=

# ---- exits --------------------------------------------------------------
TAKE_PROFIT_PCT=20
STOP_LOSS_PCT=12
MAX_HOLD_SEC=1200
EXIT_ON_LEADER_SELL=true        # only before +TP; runners ignore leader sells
LET_WINNERS_RUN=true            # +TP is the minimum, not the cap
TRAILING_STOP_PCT=10            # runner sells when price drops this far from its peak
TP_FLOOR_PCT=20                 # ...but never below this gain
RUNNER_MAX_HOLD_SEC=3600

# ---- entry analysis -----------------------------------------------------
MIN_WIN_PROB=0.55
MIN_EXPECTED_VALUE_PCT=3
MAX_CHASE_PCT=8
CONFLUENCE_WINDOW_SEC=300
CONFLUENCE_BONUS=0.15
MIN_LEADER_BUY_SOL=0.3
MIN_MARKET_CAP_SOL=25
MAX_MARKET_CAP_SOL=400
OUTCOME_HORIZON_SEC=1800

# ---- sizing / risk ------------------------------------------------------
BUY_AMOUNT_SOL=0.1
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_SOL=0.5
MINT_COOLDOWN_SEC=1800
SLIPPAGE_PCT=10
PRIORITY_FEE_SOL=0.0005
FEE_PCT=1
POOL=auto
CONFIRM_TIMEOUT_SEC=45          # live: wait for on-chain confirmation

# ---- paper realism ------------------------------------------------------
PAPER_LATENCY_SEC=1.5           # simulated fill happens this long after the decision
PAPER_SLIPPAGE_PCT=3            # extra price impact on every simulated fill
LOG_LEVEL=INFO
