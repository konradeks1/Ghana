# ---- mode ----------------------------------------------------------------
STRATEGY=ensemble             # ensemble = all tactics, best ones trade | scalp = one tactic | copy = follow top traders
# TACTIC=early_bird             # with STRATEGY=scalp: run one named tactic (see pumpbot/tactics.py)
DRY_RUN=true                  # paper trading. Set false ONLY after testing.
PAPER_BALANCE_SOL=5

# ---- PumpPortal ---------------------------------------------------------
# Required: trade/account streams need an API key funded with >= 0.02 SOL.
# Create one at https://pumpportal.fun (it creates a linked wallet; fund it).
PUMPPORTAL_API_KEY=

# ---- live trading (only when DRY_RUN=false) -----------------------------
PRIVATE_KEY=                  # base58 secret key of a DEDICATED hot wallet
RPC_URL=https://api.mainnet-beta.solana.com   # use a paid RPC (Helius, Triton...) for speed

# ==== ENSEMBLE (STRATEGY=ensemble) =======================================
# Every tactic runs in the background on a simulated wallet. The real wallet
# follows the buys of the tactics that are making the most money right now.
ENSEMBLE_TACTICS=est            # est = established coins ($25k+), new = fresh launches, all, or names
ENSEMBLE_TOP_K=4                # how many tactics may trade at once
ENSEMBLE_WINDOW_MIN=120         # rank on the last 2h of simulated results
ENSEMBLE_EXPLORE_BONUS=10       # bonus for tactics with few trades (shrinks with evidence)
ENSEMBLE_MIN_SCORE=0            # tactics scoring at or below this don't trade
ENSEMBLE_MAX_OPEN_POSITIONS=6
ENSEMBLE_SAFETY_MAX_HOLD_SEC=900
ENSEMBLE_STATE_DIR=ensemble_state

# ==== ESTABLISHED COINS ($25k+ market cap) ===============================
# Used by the est_* tactics (the ensemble default). Coins come from the live
# launch feed once they pass $25k, and from DexScreener.
DISCOVERY_MIN_MCAP_USD=25000
DISCOVERY_MAX_MCAP_USD=10000000
DISCOVERY_MIN_H1_VOLUME_USD=10000
DISCOVERY_MIN_M5_TXNS=20        # at least 20 trades in the last 5 minutes
DISCOVERY_MIN_LIQUIDITY_USD=8000
DISCOVERY_MAX_COINS=60
DISCOVERY_INTERVAL_SEC=60
# Coins found mid-life have no launch history, so their holders are checked via
# RPC (getTokenLargestAccounts). The free public RPC blocks this call: use your
# own RPC_URL (e.g. Helius free tier). With the check required and no working
# RPC, discovered coins are never bought.
REQUIRE_HOLDER_CHECK=true
HOLDER_CHECK_TTL_SEC=300
ESTABLISHED_IDLE_DROP_SEC=900
SOL_PRICE_USD=90                # fallback only; the live price is fetched automatically

# ==== SCALP STRATEGY ======================================================
# ---- which coins to look at ---------------------------------------------
SCALP_MIN_AGE_SEC=20            # let launch snipes/bundles settle first
SCALP_MAX_AGE_SEC=1800          # only coins younger than 30 min
MAX_TRACKED_TOKENS=400          # how many new coins to watch at once

# ---- socials: never buy without them ------------------------------------
REQUIRED_SOCIALS=website,twitter,instagram
SOCIALS_MODE=any                # any = at least one of them, all = every one
# IPFS_GATEWAYS=https://ipfs.filebase.io/ipfs/{cid},https://pump.mypinata.cloud/ipfs/{cid}

# ---- potential: lots of trades, real buying -----------------------------
SCALP_WINDOW_SEC=60             # activity measured over the last 60s
SCALP_MIN_TRADES=30             # at least this many trades in the window
SCALP_MIN_UNIQUE_TRADERS=15     # ...from at least this many different wallets
SCALP_MIN_BUY_RATIO=0.60        # >= 60% of SOL volume is buying
SCALP_MIN_NET_INFLOW_SOL=2      # more SOL coming in than going out
SCALP_MAX_PUMP_PCT=150          # don't buy the top: skip if up >150% within the window
SCALP_MIN_SCORE=60              # 0-100 potential score needed to buy
SCALP_MIN_MARKET_CAP_SOL=30
SCALP_MAX_MARKET_CAP_SOL=350

# ---- rug-pull protection ------------------------------------------------
RUG_MAX_DEV_PCT=10              # creator holds more than this % of supply -> skip
RUG_MAX_TOP10_PCT=35            # top-10 wallets hold more than this % -> skip
RUG_MAX_SINGLE_HOLDER_PCT=8     # any one wallet holds more than this % -> skip
RUG_MAX_EARLY_SUPPLY_PCT=25     # >25% bought in the first 3s = bundled launch -> never buy
RUG_MIN_TRADER_DIVERSITY=0.25   # few wallets making many trades = wash trading -> skip
RUG_MAX_CREATOR_LAUNCHES_PER_HOUR=3   # serial launchers -> never buy
RUG_DUMP_EXIT_PCT=3             # sell at once if one wallet dumps this % of supply

# ---- scalp exits / pacing -----------------------------------------------
SCALP_MAX_HOLD_SEC=180          # scalps are short: close after 3 min (runners excepted)
SCALP_FADE_WINDOW_SEC=15
SCALP_FADE_SELL_RATIO=0.65      # sell if >= 65% of the last 15s volume is selling
SCALP_REENTRY_COOLDOWN_SEC=60   # can scalp the same coin again after this
SCALP_MAX_ENTRIES_PER_TOKEN=3
SCALP_MAX_OPEN_POSITIONS=5
SCALP_EVAL_INTERVAL_SEC=2

# ==== EXITS (all strategies) =============================================
# Any-profit rule (default): lock in ANY net gain instead of waiting for +20%.
ANY_PROFIT_MODE=true
ANY_PROFIT_ARM_PCT=3            # net gain (after est. selling costs) that locks the trade in
ANY_PROFIT_FLOOR_PCT=1          # a locked trade never sells below this net gain...
EXIT_COST_PCT=1.5               # estimated sell fee + slippage used for "net"
# ...and it keeps running with the trailing stop below. With ANY_PROFIT_MODE=false
# the classic rule applies: TAKE_PROFIT_PCT / TP_FLOOR_PCT (e.g. +20%).
TAKE_PROFIT_PCT=20
STOP_LOSS_PCT=12
LET_WINNERS_RUN=true            # +TP is the minimum, not the cap
TRAILING_STOP_PCT=10            # runner sells when price drops this far from its peak
TP_FLOOR_PCT=20                 # ...but never below this gain
RUNNER_MAX_HOLD_SEC=3600

# ==== COPY STRATEGY (STRATEGY=copy) ======================================
TOP_N_TRADERS=25
LEADERBOARD_WINDOW_HOURS=24
MIN_ROUND_TRIPS=3
MIN_MEDIAN_HOLD_SEC=120
LEADERBOARD_REFRESH_SEC=300
SEED_TRADERS_FILE=traders.txt
EXCLUDE_WALLETS=
MAX_HOLD_SEC=1200
EXIT_ON_LEADER_SELL=true
MIN_WIN_PROB=0.55
MIN_EXPECTED_VALUE_PCT=3
MAX_CHASE_PCT=8
CONFLUENCE_WINDOW_SEC=300
CONFLUENCE_BONUS=0.15
MIN_LEADER_BUY_SOL=0.3
MIN_MARKET_CAP_SOL=25
MAX_MARKET_CAP_SOL=400
OUTCOME_HORIZON_SEC=1800
MAX_OPEN_POSITIONS=3
MINT_COOLDOWN_SEC=1800

# ==== SIZING / RISK / EXECUTION ==========================================
BUY_AMOUNT_SOL=0.1
MAX_DAILY_LOSS_SOL=0.5
SLIPPAGE_PCT=5                  # max price move accepted on a BUY (lower = better fills, more misses)
# Sells must get out even in a crash: start wide and widen after every failed try.
# (With a 5% sell limit, a coin dumping -60% within the 1.5 s fill delay left
# positions stuck all the way to -99%.)
SELL_SLIPPAGE_PCT=30
SELL_SLIPPAGE_STEP_PCT=20
SELL_SLIPPAGE_MAX_PCT=95
PRIORITY_FEE_SOL=0.0005
FEE_PCT=1
POOL=auto
CONFIRM_TIMEOUT_SEC=45          # live: wait for on-chain confirmation

# ---- paper realism ------------------------------------------------------
PAPER_LATENCY_SEC=1.5           # simulated fill happens this long after the decision
PAPER_SLIPPAGE_PCT=0.5          # extra slippage on top of the real bonding-curve price impact
LOG_LEVEL=INFO
